<?xml version="1.0" encoding="UTF-8"?>
<!-- Шаблон LaunchAgent для whisper-server. install.sh подставляет {{HOME}} и {{BREW}}. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.opencode.whisper-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{BREW}}/bin/whisper-server</string>
    <string>-m</string>
    <string>{{HOME}}/.local/share/whisper/ggml-large-v3-turbo-q5_0.bin</string>
    <string>--vad</string>
    <string>-vm</string>
    <string>{{HOME}}/.local/share/whisper/ggml-silero-v5.1.2.bin</string>
    <string>--host</string>
    <string>127.0.0.1</string>
    <string>--port</string>
    <string>8799</string>
    <string>-t</string>
    <string>8</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ProcessType</key>
  <string>Interactive</string>
  <key>StandardOutPath</key>
  <string>{{HOME}}/Library/Logs/whisper-server.log</string>
  <key>StandardErrorPath</key>
  <string>{{HOME}}/Library/Logs/whisper-server.log</string>
</dict>
</plist>
