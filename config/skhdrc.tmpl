# ~/.skhdrc — глобальные хоткеи (файл сгенерирован install.sh)
#
# Диктовка с коррекцией текста через OpenCode.
# skhd не фильтрует авто-повтор клавиши, поэтому подавление повтора
# реализовано внутри dictate.sh (окно DICTATE_DEBOUNCE_MS).
#
#   ⌥ Space        — НАЧАТЬ запись / СТОП → вставить

alt - space          : {{DICTATE}} toggle
